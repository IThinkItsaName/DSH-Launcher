<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 入口名 = `DSH Launcher`（变更集 169）：单个框架依赖 exe，命名与上游 Release 一致。
         变更集 165 曾把主程序改名为 `DSH Launcher.App`、把入口名让给 .NET Framework 写的自检引导器；
         169 退役该默认形态，主程序占回入口名（同目录、仅文件名不同 ⇒ AppContext.BaseDirectory 不变，
         run_time / launcher-data / WebView2 缓存等路径逻辑完全不受影响）。 -->
    <AssemblyName>DSH Launcher</AssemblyName>
    <RootNamespace>DshLauncher</RootNamespace>
    <ApplicationTitle>DSH Launcher</ApplicationTitle>
    <ApplicationIcon>Assets\DSHLauncher.ico</ApplicationIcon>
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 发布形态（变更集 161 → 162 自包含 → 164 定稿：框架依赖小包）。
         默认 `SelfContained=false`：不把 .NET 8 运行时打进 exe，产物约 **3.6 MB**（`dist` 里
         只有一个 exe）。代价是目标机器需要 .NET 8 Desktop Runtime (x64) ——
         缺运行时的提示交给**系统**：Windows 上由 .NET apphost 弹官方对话框（"You must install .NET"
         + 下载链接；产物内按 UTF-16LE 可命中该串）。
         可选的"中文提醒 + 三条路找运行时 + 一键下载便携运行时"那套源码仍在
         `src/DshLauncher.Bootstrapper/`（变更集 165/168），需要发"两个文件"版本时：
           1) 发布主程序时加 `-p:AssemblyName="DSH Launcher.App"`（把入口名让给引导器）
           2) `dotnet build src/DshLauncher.Bootstrapper/DshLauncher.Bootstrapper.csproj -c Release`，
              产物改名为 `DSH Launcher.exe`
         用户 2026-09-23 的取舍：不做 64.8 MB 的自包含（绿色便携版方案见
         `work-log/186`，暂缓）。
         两个形态都保留：
           * 默认（框架依赖小包）：`dotnet publish -c Release -o dist`
           * 免装 .NET 的大包：`dotnet publish -c Release -o dist -p:SelfContained=true`
             （约 64.8 MB；压缩按 SelfContained 条件开启，FDD 下压缩会报 NETSDK1176）
         写成单文件（原生库内嵌）；`SatelliteResourceLanguages` 与上游 v1.2.4 对齐
         （只保留中英语言资源，自包含形态下实测可省约 5 MB）。 -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <!-- 不把 NuGet 包自带的 XML 文档随引用拷到产物目录：dist 里只保留一个 exe。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\DSHLauncher.ico" />
    <None Remove="Assets\DeepSeek.ico" />
    <None Remove="Assets\DeepSeekOpenPlatform.ico" />
    <Resource Include="Assets\DSHLauncher.ico" />
    <Resource Include="Assets\DeepSeek.ico" />
    <Resource Include="Assets\DeepSeekOpenPlatform.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
